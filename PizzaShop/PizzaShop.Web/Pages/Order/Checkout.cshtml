@page
@model PizzaShop.Web.Pages.Order.CheckoutModel
@{
    ViewData["Title"] = "Checkout";
}

<h1 class="mb-4">Checkout</h1>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (Model.CartItems.Count == 0)
{
    <div class="alert alert-info">
        Your cart is empty. <a asp-page="/Order/Menu">Add some pizzas first!</a>
    </div>
}
else
{
    <!-- Cart summary -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header fw-bold">Your Order</div>
        <ul class="list-group list-group-flush">
            @for (int i = 0; i < Model.CartItems.Count; i++)
            {
                var item = Model.CartItems[i];
                <li class="list-group-item d-flex justify-content-between align-items-start">
                    <div>
                        <strong>@item.DisplayName</strong> &mdash; @item.Size
                        <br />
                        <small class="text-muted">Sauce: @item.SauceName</small><br />
                        <small class="text-muted">Toppings: @(item.IngredientNames.Count > 0 ? string.Join(", ", item.IngredientNames) : "none")</small>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <span class="fw-bold text-danger">&euro;@item.Price.ToString("0.00")</span>
                        <form method="post" asp-page-handler="Remove">
                            <input type="hidden" name="index" value="@i" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary">&times;</button>
                        </form>
                    </div>
                </li>
            }
        </ul>
        <div class="card-footer d-flex justify-content-between fw-bold fs-5">
            <span>Total</span>
            <span class="text-danger">&euro;@Model.Total.ToString("0.00")</span>
        </div>
    </div>

    <div class="alert alert-warning">
        <strong>Payment:</strong> Cash on delivery &mdash; our driver will collect payment face to face. No card, no app, just cold hard cash (or warm, we don't judge).
    </div>

    <!-- Delivery details form -->
    <div class="card shadow-sm">
        <div class="card-header fw-bold">Delivery Details</div>
        <div class="card-body">
            <form method="post" asp-page-handler="PlaceOrder">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="CustomerName" class="form-label">Full Name</label>
                        <input asp-for="CustomerName" class="form-control" placeholder="John Doe" required />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label">Phone</label>
                        <input asp-for="Phone" class="form-control" placeholder="+1 555 000 000" required />
                    </div>
                    <div class="col-12">
                        <label asp-for="Street" class="form-label">Street Address</label>
                        <input asp-for="Street" class="form-control" placeholder="123 Main St" required />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="City" class="form-label">City</label>
                        <input asp-for="City" class="form-control" placeholder="Springfield" required />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PostalCode" class="form-label">Postal Code</label>
                        <input asp-for="PostalCode" class="form-control" placeholder="12345" required />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="RequestedDeliveryTime" class="form-label">Requested Delivery Time</label>
                        <input asp-for="RequestedDeliveryTime" type="datetime-local" class="form-control"
                               value="@Model.RequestedDeliveryTime.ToString("yyyy-MM-ddTHH:mm")" required />
                    </div>
                    <div class="col-12 mt-2">
                        <button type="submit" class="btn btn-danger btn-lg px-5">Place Order</button>
                        <a asp-page="/Order/Menu" class="btn btn-outline-secondary btn-lg ms-2">Add More Pizzas</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

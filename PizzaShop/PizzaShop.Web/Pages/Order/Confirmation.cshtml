@page "{id}"
@model PizzaShop.Web.Pages.Order.ConfirmationModel
@{
    ViewData["Title"] = "Order Confirmed!";
}

<div class="text-center py-4">
    <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="text-success mb-3" viewBox="0 0 16 16">
        <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
    </svg>
    <h1 class="fw-bold">Order Confirmed!</h1>
    <p class="lead text-muted">Your pizza is in good hands. Probably.</p>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-warning">@Model.ErrorMessage</div>
}
else if (Model.Order != null)
{
    var order = Model.Order;
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header d-flex justify-content-between">
                    <span class="fw-bold">Order #@order.Id</span>
                    <span class="badge bg-warning text-dark">@order.Status</span>
                </div>
                <div class="card-body">
                    <p><strong>Delivering to:</strong> @order.CustomerName</p>
                    <p><strong>Address:</strong> @order.Street, @order.City, @order.PostalCode</p>
                    <p><strong>Requested at:</strong> @order.RequestedDeliveryTime.ToString("dd MMM yyyy HH:mm")</p>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header fw-bold">Your Pizzas</div>
                <ul class="list-group list-group-flush">
                    @foreach (var pizza in order.Pizzas)
                    {
                        <li class="list-group-item d-flex justify-content-between">
                            <div>
                                <strong>@pizza.PizzaDisplayName</strong> &mdash; @pizza.Size<br />
                                <small class="text-muted">@pizza.SauceName | @string.Join(", ", pizza.IngredientNames)</small>
                            </div>
                            <span class="text-danger fw-bold">&euro;@pizza.Price.ToString("0.00")</span>
                        </li>
                    }
                </ul>
                <div class="card-footer d-flex justify-content-between fw-bold fs-5">
                    <span>Total</span>
                    <span class="text-danger">&euro;@order.TotalPrice.ToString("0.00")</span>
                </div>
            </div>

            <div class="alert alert-success">
                <strong>Remember:</strong> Payment is collected on delivery &mdash; cash only. Our driver will knock on your door, pizza in hand, and a smile on their face (results may vary).
            </div>

            <div class="text-center">
                <a asp-page="/Order/Menu" class="btn btn-danger">Order More</a>
                <a asp-page="/Index" class="btn btn-outline-secondary ms-2">Back to Home</a>
            </div>
        </div>
    </div>
}

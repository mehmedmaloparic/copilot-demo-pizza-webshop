@page
@model IndexModel
@{
    ViewData["Title"] = "Welcome";
}

<div class="text-center py-5">
    <h1 class="display-3 fw-bold">Pizza Shop</h1>
    <p class="lead text-muted mb-4">Freshly baked, delivered to your door. Pay face to face &mdash; no awkward card readers!</p>
    <a asp-page="/Order/Menu" class="btn btn-danger btn-lg px-5">Order Now</a>
</div>

<div class="row g-4 mt-2">
    <div class="col-md-4 text-center">
        <div class="mb-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="text-danger" viewBox="0 0 16 16">
                <path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0zm0 1a7 7 0 0 1 6.234 3.807L8.546 6.923a1.5 1.5 0 0 0-1.092 0L1.766 4.807A7 7 0 0 1 8 1zM1.16 5.58l5.58 2.15a1.5 1.5 0 0 0 .52.093h1.48a1.5 1.5 0 0 0 .52-.092l5.58-2.15A7 7 0 0 1 8 15a7 7 0 0 1-6.84-9.42z"/>
            </svg>
        </div>
        <h4>Pick Your Pizza</h4>
        <p class="text-muted">Choose from our chef-crafted classics or build your own masterpiece from scratch.</p>
    </div>
    <div class="col-md-4 text-center">
        <div class="mb-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="text-danger" viewBox="0 0 16 16">
                <path d="M0 3.5A1.5 1.5 0 0 1 1.5 2h9A1.5 1.5 0 0 1 12 3.5V5h1.02a1.5 1.5 0 0 1 1.17.563l1.481 1.85a1.5 1.5 0 0 1 .329.938V10.5a1.5 1.5 0 0 1-1.5 1.5H14a2 2 0 1 1-4 0H5a2 2 0 1 1-3.998-.085A1.5 1.5 0 0 1 0 10.5v-7zm1.294 7.456A2 2 0 0 1 4.732 11h5.536a2 2 0 0 1 .732-.732V3.5a.5.5 0 0 0-.5-.5h-9a.5.5 0 0 0-.5.5v7a.5.5 0 0 0 .294.456zM12 10a2 2 0 0 1 1.732 1h.768a.5.5 0 0 0 .5-.5V8.35a.5.5 0 0 0-.11-.312l-1.48-1.85A.5.5 0 0 0 13.02 6H12v4zm-9 1a1 1 0 1 0 0 2 1 1 0 0 0 0-2zm9 0a1 1 0 1 0 0 2 1 1 0 0 0 0-2z"/>
            </svg>
        </div>
        <h4>Choose Delivery Time</h4>
        <p class="text-muted">Schedule your delivery whenever suits you. We'll be there, piping hot.</p>
    </div>
    <div class="col-md-4 text-center">
        <div class="mb-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="text-danger" viewBox="0 0 16 16">
                <path d="M8 10a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/>
                <path d="M0 4a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V4zm3 0a2 2 0 0 1-2 2v4a2 2 0 0 1 2 2h10a2 2 0 0 1 2-2V6a2 2 0 0 1-2-2H3z"/>
            </svg>
        </div>
        <h4>Pay at the Door</h4>
        <p class="text-muted">No online payments. Just good old-fashioned cash when your delivery arrives.</p>
    </div>
</div>
